~version: "2.1"

# www.inside.com.tw

title:          //h1[contains(@class, "post_header_title")]
subtitle:       //div[contains(@class, "post_introduction")]
author:         //div[contains(@class, "post_author_g")]//a[@rel="author"]
author_url:     //div[contains(@class, "post_author_g")]//a[@rel="author"]/@href
published_date: //li[contains(@class, "post_date")]//span
site_name:      "INSIDE"

body: //section[contains(@class, "js-article-content-body")]

# 阻止 IV 去抓相關文章子頁
@remove: //meta[@property="og:see_also"]

# 清掉內文雜訊
@remove: $body//div[contains(@class, "ad-content")]
@remove: $body//div[contains(@class, "tmgad")]
@remove: $body//ul[.//li[contains(@class, "post_title")]]
@remove: $body//script
@remove: $body//style
